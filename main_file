import React, { useState, useEffect, useMemo, useRef } from 'react';
import { 
  Flame, Calendar, Check, Plus, Trash2, Edit3, Download, Upload, 
  RotateCcw, Sparkles, Trophy, Target, Shield, Bell, Smartphone, 
  ChevronLeft, ChevronRight, Activity, Filter, Info, Settings,
  Dumbbell, Heart, Droplets, Moon, Brain, Apple, Sun, CheckCircle2,
  X, HelpCircle, Layers, BarChart3, Zap, Globe, Rocket, Volume2, VolumeX,
  Vibrate, Copy, ExternalLink, RefreshCw
} from 'lucide-react';

// --- Storage Engine Wrapper ---
const STORAGE_KEY = 'fitpulse_pwa_habits_db_v1';
const LOGS_STORAGE_KEY = 'fitpulse_pwa_logs_db_v1';

const DB = {
  getHabits: () => {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : null;
    } catch (e) {
      console.error("Storage load error", e);
      return null;
    }
  },
  saveHabits: (habits) => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(habits));
    } catch (e) {
      console.error("Storage save error", e);
    }
  },
  getLogs: () => {
    try {
      const data = localStorage.getItem(LOGS_STORAGE_KEY);
      return data ? JSON.parse(data) : {};
    } catch (e) {
      console.error("Logs storage load error", e);
      return {};
    }
  },
  saveLogs: (logs) => {
    try {
      localStorage.setItem(LOGS_STORAGE_KEY, JSON.stringify(logs));
    } catch (e) {
      console.error("Logs storage save error", e);
    }
  }
};

// Default Pre-populated Habits
const INITIAL_HABITS = [
  {
    id: 'h1',
    name: 'Morning Hydration',
    category: 'Hydration',
    icon: 'Droplets',
    color: '#38bdf8',
    targetDaysPerWeek: 7,
    reminderTime: '08:00',
    createdAt: new Date().toISOString()
  },
  {
    id: 'h2',
    name: '30-Min Workout',
    category: 'Workouts',
    icon: 'Dumbbell',
    color: '#22c55e',
    targetDaysPerWeek: 5,
    reminderTime: '17:30',
    createdAt: new Date().toISOString()
  },
  {
    id: 'h3',
    name: 'Mindful Meditation',
    category: 'Mindfulness',
    icon: 'Brain',
    color: '#a855f7',
    targetDaysPerWeek: 7,
    reminderTime: '07:00',
    createdAt: new Date().toISOString()
  },
  {
    id: 'h4',
    name: '8 Hours Sleep Target',
    category: 'Sleep',
    icon: 'Moon',
    color: '#6366f1',
    targetDaysPerWeek: 7,
    reminderTime: '22:00',
    createdAt: new Date().toISOString()
  }
];

const formatDateKey = (date) => {
  const d = new Date(date);
  const year = d.getFullYear();
  const month = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${year}-${month}-${day}`;
};

const HabitIcon = ({ name, className = "w-5 h-5", color }) => {
  const props = { className, style: color ? { color } : {} };
  switch (name) {
    case 'Dumbbell': return <Dumbbell {...props} />;
    case 'Heart': return <Heart {...props} />;
    case 'Droplets': return <Droplets {...props} />;
    case 'Moon': return <Moon {...props} />;
    case 'Brain': return <Brain {...props} />;
    case 'Apple': return <Apple {...props} />;
    case 'Activity': return <Activity {...props} />;
    default: return <Sparkles {...props} />;
  }
};

export default function App() {
  const [activeTab, setActiveTab] = useState('dashboard'); // 'dashboard', 'analytics', 'manage', 'deploy', 'settings'
  const [habits, setHabits] = useState([]);
  const [logs, setLogs] = useState({});
  const [selectedDate, setSelectedDate] = useState(formatDateKey(new Date()));
  const [categoryFilter, setCategoryFilter] = useState('All');
  
  // Settings & Sound Effects
  const [soundEnabled, setSoundEnabled] = useState(true);
  const [vibrationEnabled, setVibrationEnabled] = useState(true);
  
  // Modal / Form States
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [editingHabit, setEditingHabit] = useState(null);
  const [formData, setFormData] = useState({
    name: '',
    category: 'Workouts',
    icon: 'Dumbbell',
    color: '#22c55e',
    targetDaysPerWeek: 7,
    reminderTime: '09:00'
  });

  // UI Micro-interactions & PWA Prompts
  const [celebration, setCelebration] = useState(null);
  const [deferredPrompt, setDeferredPrompt] = useState(null);
  const [isPwaInstalled, setIsPwaInstalled] = useState(false);
  const [notificationPermission, setNotificationPermission] = useState('default');
  const [copiedCode, setCopiedCode] = useState(null);

  // Cross-Tab Broadcast Channel initialization
  const broadcastChannelRef = useRef(null);

  useEffect(() => {
    // Sync across tabs without server
    if ('BroadcastChannel' in window) {
      broadcastChannelRef.current = new BroadcastChannel('fitpulse_tab_sync');
      broadcastChannelRef.current.onmessage = (event) => {
        if (event.data?.type === 'SYNC_DATA') {
          const freshHabits = DB.getHabits();
          const freshLogs = DB.getLogs();
          if (freshHabits) setHabits(freshHabits);
          if (freshLogs) setLogs(freshLogs);
        }
      };
    }

    const savedHabits = DB.getHabits();
    if (savedHabits && savedHabits.length > 0) {
      setHabits(savedHabits);
    } else {
      setHabits(INITIAL_HABITS);
      DB.saveHabits(INITIAL_HABITS);
    }

    const savedLogs = DB.getLogs();
    setLogs(savedLogs);

    if ('Notification' in window) {
      setNotificationPermission(Notification.permission);
    }

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      setDeferredPrompt(e);
    });

    window.addEventListener('appinstalled', () => {
      setIsPwaInstalled(true);
      setDeferredPrompt(null);
    });

    return () => {
      if (broadcastChannelRef.current) {
        broadcastChannelRef.current.close();
      }
    };
  }, []);

  // Save changes & notify other tabs
  const broadcastSync = () => {
    if (broadcastChannelRef.current) {
      broadcastChannelRef.current.postMessage({ type: 'SYNC_DATA' });
    }
  };

  useEffect(() => {
    if (habits.length > 0) {
      DB.saveHabits(habits);
    }
  }, [habits]);

  useEffect(() => {
    DB.saveLogs(logs);
  }, [logs]);

  // Handle Log Toggle with Sound & Haptic Feedback
  const toggleHabitCompletion = (habitId, dateKey = selectedDate) => {
    setLogs(prevLogs => {
      const dayLogs = prevLogs[dateKey] || {};
      const newStatus = !dayLogs[habitId];
      
      const updatedDayLogs = {
        ...dayLogs,
        [habitId]: newStatus
      };

      const updated = {
        ...prevLogs,
        [dateKey]: updatedDayLogs
      };

      DB.saveLogs(updated);
      broadcastSync();

      if (newStatus && dateKey === formatDateKey(new Date())) {
        triggerCelebration();
      }

      return updated;
    });
  };

  const triggerCelebration = () => {
    setCelebration(true);

    // Vibration Haptic Feedback
    if (vibrationEnabled && 'vibrate' in navigator) {
      navigator.vibrate([40, 60, 40]);
    }

    // Audio Feedback
    if (soundEnabled) {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(587.33, audioCtx.currentTime); // D5
        osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.15); // A5
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.2);
      } catch(e) {
        // Audio playback restricted or unsupported
      }
    }

    setTimeout(() => {
      setCelebration(false);
    }, 1800);
  };

  const getStreakData = (habitId) => {
    let currentStreak = 0;
    let longestStreak = 0;
    let tempStreak = 0;

    const today = new Date();
    for (let i = 0; i < 365; i++) {
      const d = new Date();
      d.setDate(today.getDate() - i);
      const dateKey = formatDateKey(d);
      const isCompleted = logs[dateKey] && logs[dateKey][habitId];

      if (isCompleted) {
        tempStreak++;
        if (i === 0 || i === 1 || currentStreak > 0) {
          currentStreak = tempStreak;
        }
        if (tempStreak > longestStreak) {
          longestStreak = tempStreak;
        }
      } else {
        if (i === 0) continue;
        tempStreak = 0;
      }
    }

    return { currentStreak, longestStreak };
  };

  const filteredHabits = useMemo(() => {
    if (categoryFilter === 'All') return habits;
    return habits.filter(h => h.category === categoryFilter);
  }, [habits, categoryFilter]);

  const selectedDateLogs = logs[selectedDate] || {};
  const completedCountForDate = filteredHabits.filter(h => selectedDateLogs[h.id]).length;
  const totalCountForDate = filteredHabits.length;
  const completionPercentage = totalCountForDate > 0 
    ? Math.round((completedCountForDate / totalCountForDate) * 100) 
    : 0;

  const handleFormSubmit = (e) => {
    e.preventDefault();
    if (!formData.name.trim()) return;

    if (editingHabit) {
      const updated = habits.map(h => h.id === editingHabit.id ? { ...h, ...formData } : h);
      setHabits(updated);
      DB.saveHabits(updated);
    } else {
      const newHabit = {
        ...formData,
        id: 'h_' + Date.now(),
        createdAt: new Date().toISOString()
      };
      const updated = [...habits, newHabit];
      setHabits(updated);
      DB.saveHabits(updated);
    }

    broadcastSync();
    setIsModalOpen(false);
    setEditingHabit(null);
    setFormData({
      name: '',
      category: 'Workouts',
      icon: 'Dumbbell',
      color: '#22c55e',
      targetDaysPerWeek: 7,
      reminderTime: '09:00'
    });
  };

  const startEditHabit = (habit) => {
    setEditingHabit(habit);
    setFormData({
      name: habit.name,
      category: habit.category,
      icon: habit.icon,
      color: habit.color,
      targetDaysPerWeek: habit.targetDaysPerWeek || 7,
      reminderTime: habit.reminderTime || '09:00'
    });
    setIsModalOpen(true);
  };

  const deleteHabit = (habitId) => {
    if (window.confirm("Are you sure you want to delete this habit?")) {
      const updated = habits.filter(h => h.id !== habitId);
      setHabits(updated);
      DB.saveHabits(updated);
      broadcastSync();
    }
  };

  const handleExportData = () => {
    const exportData = {
      version: '1.0',
      timestamp: new Date().toISOString(),
      habits,
      logs
    };
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(exportData, null, 2));
    const downloadAnchor = document.createElement('a');
    downloadAnchor.setAttribute("href", dataStr);
    downloadAnchor.setAttribute("download", `fitpulse_backup_${formatDateKey(new Date())}.json`);
    document.body.appendChild(downloadAnchor);
    downloadAnchor.click();
    downloadAnchor.remove();
  };

  const handleImportData = (e) => {
    const fileReader = new FileReader();
    if (e.target.files && e.target.files[0]) {
      fileReader.readAsText(e.target.files[0], "UTF-8");
      fileReader.onload = (event) => {
        try {
          const parsed = JSON.parse(event.target.result);
          if (parsed.habits && parsed.logs) {
            setHabits(parsed.habits);
            setLogs(parsed.logs);
            DB.saveHabits(parsed.habits);
            DB.saveLogs(parsed.logs);
            broadcastSync();
            alert("Data restored successfully!");
          } else {
            alert("Invalid backup file format.");
          }
        } catch (err) {
          alert("Failed to parse JSON file.");
        }
      };
    }
  };

  const handleResetData = () => {
    if (window.confirm("WARNING: This will permanently erase all local habit data. Continue?")) {
      localStorage.removeItem(STORAGE_KEY);
      localStorage.removeItem(LOGS_STORAGE_KEY);
      setHabits(INITIAL_HABITS);
      setLogs({});
      broadcastSync();
      alert("App data reset to default.");
    }
  };

  const requestNotificationPermission = async () => {
    if ('Notification' in window) {
      const result = await Notification.requestPermission();
      setNotificationPermission(result);
      if (result === 'granted') {
        new Notification("FitPulse Habit Tracker", {
          body: "Notifications active! You will receive daily habit completion reminders.",
          icon: "https://cdn-icons-png.flaticon.com/512/2965/2965318.png"
        });
      }
    }
  };

  const promptPwaInstall = () => {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      deferredPrompt.userChoice.then((choiceResult) => {
        if (choiceResult.outcome === 'accepted') {
          setIsPwaInstalled(true);
        }
        setDeferredPrompt(null);
      });
    }
  };

  const copyToClipboard = (text, key) => {
    navigator.clipboard.writeText(text);
    setCopiedCode(key);
    setTimeout(() => setCopiedCode(null), 2000);
  };

  const categories = ['All', 'Workouts', 'Cardio', 'Hydration', 'Mindfulness', 'Nutrition', 'Sleep'];

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 font-sans flex flex-col antialiased selection:bg-emerald-500 selection:text-slate-900">
      
      {/* Toast Notification */}
      {celebration && (
        <div className="fixed top-6 left-1/2 -translate-x-1/2 z-50 bg-emerald-500 text-slate-950 font-bold px-6 py-3 rounded-full shadow-2xl flex items-center space-x-2 animate-bounce border-2 border-emerald-300">
          <Trophy className="w-5 h-5" />
          <span>Habit Completed! Keep the streak alive! 🔥</span>
        </div>
      )}

      {/* Top Navigation Header */}
      <header className="sticky top-0 z-30 bg-slate-900/80 backdrop-blur-md border-b border-slate-800/80 px-4 py-3.5 flex items-center justify-between">
        <div className="flex items-center space-x-2.5">
          <div className="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-emerald-500/20">
            <Zap className="w-5 h-5 text-slate-950 stroke-[2.5]" />
          </div>
          <div>
            <h1 className="text-lg font-bold tracking-tight leading-none text-white flex items-center gap-1.5">
              FitPulse <span className="text-[10px] bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-semibold px-1.5 py-0.5 rounded-md">PWA</span>
            </h1>
            <p className="text-xs text-slate-400 mt-0.5">100% Free Cross-Platform Habit Tracker</p>
          </div>
        </div>

        <div className="flex items-center space-x-2">
          {deferredPrompt && !isPwaInstalled && (
            <button
              onClick={promptPwaInstall}
              className="hidden sm:flex items-center space-x-1.5 text-xs bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold px-3 py-1.5 rounded-lg transition-colors shadow-md shadow-emerald-500/20"
            >
              <Smartphone className="w-3.5 h-3.5" />
              <span>Install App</span>
            </button>
          )}
          <button
            onClick={() => {
              setEditingHabit(null);
              setFormData({
                name: '',
                category: 'Workouts',
                icon: 'Dumbbell',
                color: '#22c55e',
                targetDaysPerWeek: 7,
                reminderTime: '09:00'
              });
              setIsModalOpen(true);
            }}
            className="flex items-center space-x-1 text-xs bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-medium px-3 py-1.5 rounded-lg transition-colors"
          >
            <Plus className="w-4 h-4 text-emerald-400" />
            <span>New Habit</span>
          </button>
        </div>
      </header>

      {/* Main App Canvas */}
      <main className="flex-1 max-w-4xl w-full mx-auto p-4 sm:p-6 pb-24 space-y-6">

        {/* Tab Navigation */}
        <div className="flex bg-slate-900/90 p-1 rounded-xl border border-slate-800/80 shadow-inner overflow-x-auto no-scrollbar">
          <button
            onClick={() => setActiveTab('dashboard')}
            className={`flex-1 flex items-center justify-center space-x-2 py-2.5 px-3 rounded-lg text-xs sm:text-sm font-medium transition-all whitespace-nowrap ${
              activeTab === 'dashboard'
                ? 'bg-slate-800 text-emerald-400 shadow-md border border-slate-700/50'
                : 'text-slate-400 hover:text-slate-200'
            }`}
          >
            <CheckCircle2 className="w-4 h-4" />
            <span>Today</span>
          </button>
          <button
            onClick={() => setActiveTab('analytics')}
            className={`flex-1 flex items-center justify-center space-x-2 py-2.5 px-3 rounded-lg text-xs sm:text-sm font-medium transition-all whitespace-nowrap ${
              activeTab === 'analytics'
                ? 'bg-slate-800 text-emerald-400 shadow-md border border-slate-700/50'
                : 'text-slate-400 hover:text-slate-200'
            }`}
          >
            <BarChart3 className="w-4 h-4" />
            <span>Analytics</span>
          </button>
          <button
            onClick={() => setActiveTab('manage')}
            className={`flex-1 flex items-center justify-center space-x-2 py-2.5 px-3 rounded-lg text-xs sm:text-sm font-medium transition-all whitespace-nowrap ${
              activeTab === 'manage'
                ? 'bg-slate-800 text-emerald-400 shadow-md border border-slate-700/50'
                : 'text-slate-400 hover:text-slate-200'
            }`}
          >
            <Layers className="w-4 h-4" />
            <span>Habits ({habits.length})</span>
          </button>
          <button
            onClick={() => setActiveTab('deploy')}
            className={`flex-1 flex items-center justify-center space-x-2 py-2.5 px-3 rounded-lg text-xs sm:text-sm font-medium transition-all whitespace-nowrap ${
              activeTab === 'deploy'
                ? 'bg-slate-800 text-emerald-400 shadow-md border border-slate-700/50'
                : 'text-slate-400 hover:text-slate-200'
            }`}
          >
            <Rocket className="w-4 h-4" />
            <span>Deploy / Install</span>
          </button>
          <button
            onClick={() => setActiveTab('settings')}
            className={`flex-1 flex items-center justify-center space-x-2 py-2.5 px-3 rounded-lg text-xs sm:text-sm font-medium transition-all whitespace-nowrap ${
              activeTab === 'settings'
                ? 'bg-slate-800 text-emerald-400 shadow-md border border-slate-700/50'
                : 'text-slate-400 hover:text-slate-200'
            }`}
          >
            <Settings className="w-4 h-4" />
            <span>Settings</span>
          </button>
        </div>

        {/* TAB 1: DASHBOARD / TODAY */}
        {activeTab === 'dashboard' && (
          <div className="space-y-6">

            <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
              
              {/* Animated Ring Summary */}
              <div className="md:col-span-1 bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 flex flex-col items-center justify-center relative overflow-hidden backdrop-blur-sm">
                <div className="relative w-32 h-32 flex items-center justify-center">
                  <svg className="w-full h-full transform -rotate-90">
                    <circle
                      cx="64"
                      cy="64"
                      r="52"
                      stroke="currentColor"
                      strokeWidth="10"
                      className="text-slate-800"
                      fill="transparent"
                    />
                    <circle
                      cx="64"
                      cy="64"
                      r="52"
                      stroke="currentColor"
                      strokeWidth="10"
                      className="text-emerald-500 transition-all duration-700 ease-out"
                      fill="transparent"
                      strokeDasharray={2 * Math.PI * 52}
                      strokeDashoffset={2 * Math.PI * 52 * (1 - completionPercentage / 100)}
                      strokeLinecap="round"
                    />
                  </svg>
                  <div className="absolute flex flex-col items-center justify-center text-center">
                    <span className="text-2xl font-black text-white tracking-tight">{completionPercentage}%</span>
                    <span className="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">Done</span>
                  </div>
                </div>
                <p className="mt-3 text-xs text-slate-400 text-center font-medium">
                  {completedCountForDate} of {totalCountForDate} habits completed
                </p>
              </div>

              {/* Date Selector & Category Filter */}
              <div className="md:col-span-2 bg-slate-900/60 border border-slate-800/80 rounded-2xl p-5 flex flex-col justify-between space-y-4">
                
                <div className="flex items-center justify-between bg-slate-950/60 p-2.5 rounded-xl border border-slate-800/50">
                  <button
                    onClick={() => {
                      const d = new Date(selectedDate);
                      d.setDate(d.getDate() - 1);
                      setSelectedDate(formatDateKey(d));
                    }}
                    className="p-1.5 hover:bg-slate-800 text-slate-400 hover:text-slate-100 rounded-lg transition-colors"
                  >
                    <ChevronLeft className="w-5 h-5" />
                  </button>

                  <div className="flex items-center space-x-2">
                    <Calendar className="w-4 h-4 text-emerald-400" />
                    <span className="text-sm font-semibold text-slate-200">
                      {selectedDate === formatDateKey(new Date()) ? 'Today, ' : ''}
                      {new Date(selectedDate + 'T00:00:00').toLocaleDateString('en-US', {
                        weekday: 'short',
                        month: 'short',
                        day: 'numeric'
                      })}
                    </span>
                  </div>

                  <button
                    onClick={() => {
                      const d = new Date(selectedDate);
                      d.setDate(d.getDate() + 1);
                      setSelectedDate(formatDateKey(d));
                    }}
                    className="p-1.5 hover:bg-slate-800 text-slate-400 hover:text-slate-100 rounded-lg transition-colors"
                  >
                    <ChevronRight className="w-5 h-5" />
                  </button>
                </div>

                <div>
                  <div className="flex items-center justify-between mb-2">
                    <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1">
                      <Filter className="w-3.5 h-3.5 text-slate-500" /> Filter
                    </span>
                  </div>
                  <div className="flex space-x-1.5 overflow-x-auto pb-1 no-scrollbar">
                    {categories.map((cat) => (
                      <button
                        key={cat}
                        onClick={() => setCategoryFilter(cat)}
                        className={`text-xs px-3 py-1.5 rounded-lg whitespace-nowrap transition-all font-medium ${
                          categoryFilter === cat
                            ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-sm'
                            : 'bg-slate-800/60 text-slate-400 hover:text-slate-200 border border-transparent'
                        }`}
                      >
                        {cat}
                      </button>
                    ))}
                  </div>
                </div>

              </div>
            </div>

            {/* Checklist items */}
            <div className="space-y-3">
              <div className="flex items-center justify-between">
                <h2 className="text-sm font-semibold text-slate-300 uppercase tracking-wider flex items-center gap-2">
                  <Target className="w-4 h-4 text-emerald-400" /> Habit Checklists
                </h2>
                <span className="text-xs text-slate-500">Tap card to complete</span>
              </div>

